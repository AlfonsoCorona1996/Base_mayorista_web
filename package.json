{
  "name": "admin-web",
  "version": "2.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run admin-web:storybook",
    "build-storybook": "ng run admin-web:build-storybook",
    "version:check": "node scripts/check-release-version.mjs",
    "firebase:migrate-finance:dry": "tsx scripts/migrate-finance-bootstrap.ts",
    "firebase:migrate-finance:apply": "tsx scripts/migrate-finance-bootstrap.ts --apply",
    "firebase:migrate-users-canonical:dry": "tsx scripts/migrate-users-canonical-fields.ts",
    "firebase:migrate-users-canonical:apply": "tsx scripts/migrate-users-canonical-fields.ts --apply",
    "firebase:migrate-users-canonical:cleanup": "tsx scripts/migrate-users-canonical-fields.ts --apply --delete-legacy",
    "firebase:migrate-business-scope:dry": "tsx scripts/migrate-business-scope.ts",
    "firebase:migrate-business-scope:apply": "tsx scripts/migrate-business-scope.ts --apply",
    "firebase:migrate-manual-history-business:dry": "tsx scripts/migrate-manual-history-business.ts",
    "firebase:migrate-manual-history-business:apply": "tsx scripts/migrate-manual-history-business.ts --apply",
    "firebase:migrate-catalog-products-search:dry": "tsx scripts/migrate-catalog-products-search.ts",
    "firebase:migrate-catalog-products-search:apply": "tsx scripts/migrate-catalog-products-search.ts --apply",
    "firebase:migrate-normalized-listings-sku-index:dry": "tsx scripts/migrate-normalized-listings-sku-index.ts",
    "firebase:migrate-normalized-listings-sku-index:apply": "tsx scripts/migrate-normalized-listings-sku-index.ts --apply",
    "firebase:migrate-manual-history:dry": "tsx scripts/migrate-manual-product-history.ts",
    "firebase:migrate-manual-history:apply": "tsx scripts/migrate-manual-product-history.ts --apply",
    "firebase:migrate-returns-crm:dry": "tsx scripts/migrate-returns-inventory-crm.ts",
    "firebase:migrate-returns-crm:apply": "tsx scripts/migrate-returns-inventory-crm.ts --apply"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.25",
    "@angular/compiler": "20.3.25",
    "@angular/core": "20.3.25",
    "@angular/forms": "20.3.25",
    "@angular/platform-browser": "20.3.25",
    "@angular/router": "20.3.25",
    "@angular/service-worker": "20.3.25",
    "@zxing/browser": "0.1.5",
    "@zxing/library": "0.21.3",
    "firebase": "^12.7.0",
    "jszip": "^3.10.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0",
    "ulid": "^3.0.2",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.25",
    "@angular/animations": "^20.3.25",
    "@angular/build": "20.3.25",
    "@angular/cli": "20.3.25",
    "@angular/compiler-cli": "20.3.25",
    "@angular/platform-browser-dynamic": "^20.3.25",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/angular": "^10.5.7",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^13.6.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "storybook": "^10.5.7",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
