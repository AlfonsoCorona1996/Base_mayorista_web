{
  "name": "admin-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "firebase:migrate-finance:dry": "tsx scripts/migrate-finance-bootstrap.ts",
    "firebase:migrate-finance:apply": "tsx scripts/migrate-finance-bootstrap.ts --apply",
    "firebase:migrate-users-canonical:dry": "tsx scripts/migrate-users-canonical-fields.ts",
    "firebase:migrate-users-canonical:apply": "tsx scripts/migrate-users-canonical-fields.ts --apply",
    "firebase:migrate-users-canonical:cleanup": "tsx scripts/migrate-users-canonical-fields.ts --apply --delete-legacy"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "firebase": "^12.7.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ulid": "^3.0.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.13",
    "@angular/cli": "^20.3.13",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^13.6.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
