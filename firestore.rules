rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && userDoc().exists() && userDoc().data.isActive == true;
    }

    function roleId() {
      return userDoc().data.roleId;
    }

    function isSuperAdmin() {
      return isActiveUser() && roleId() == "super_admin";
    }

    function isAdmin() {
      return isActiveUser() && (roleId() == "admin" || roleId() == "super_admin");
    }

    function isOperativo() {
      return isActiveUser() && roleId() == "operativo";
    }

    function isDurangoOperativo() {
      return isActiveUser() && roleId() == "durango_operativo";
    }

    function hasSection(sectionKey) {
      return isActiveUser()
        && userDoc().data.sections != null
        && userDoc().data.sections[sectionKey] == true;
    }

    function hasCapability(capabilityKey) {
      return isActiveUser()
        && userDoc().data.capabilities != null
        && userDoc().data.capabilities[capabilityKey] == true;
    }

    function hasBusiness(businessId) {
      return isActiveUser()
        && (
          isSuperAdmin()
          || (
            userDoc().data.businessMemberships != null
            && userDoc().data.businessMemberships[businessId] != null
            && userDoc().data.businessMemberships[businessId].enabled == true
          )
        );
    }

    function resourceBusinessId() {
      return resource.data.business_id == null ? "bm" : resource.data.business_id;
    }

    function incomingBusinessId() {
      return request.resource.data.business_id == null ? "bm" : request.resource.data.business_id;
    }

    function canReadBusinessResource() {
      return hasBusiness(resourceBusinessId());
    }

    function canCreateBusinessResource() {
      return hasBusiness(incomingBusinessId());
    }

    function canUpdateBusinessResource() {
      return hasBusiness(resourceBusinessId())
        && hasBusiness(incomingBusinessId())
        && incomingBusinessId() == resourceBusinessId();
    }

    function orderBusinessId(orderId) {
      let orderDoc = get(/databases/$(database)/documents/orders/$(orderId));
      return orderDoc.data.business_id == null ? "bm" : orderDoc.data.business_id;
    }

    function canAccessOrder(orderId) {
      return isActiveUser() && hasBusiness(orderBusinessId(orderId));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanges(keys) {
      return changedKeys().hasOnly(keys);
    }

    match /users/{uid} {
      allow read: if isActiveUser();
      allow create: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isSuperAdmin()
        || (
          isAdmin()
          && request.resource.data.roleId != "super_admin"
          && resource.data.roleId != "super_admin"
        )
        || (
          isSignedIn()
          && request.auth.uid == uid
          && (
            onlyChanges(["displayName", "updatedAt"])
            || (
              resource.data.mustChangePassword == true
              && onlyChanges(["isActive", "mustChangePassword", "updatedAt"])
              && request.resource.data.isActive == true
              && request.resource.data.mustChangePassword == false
            )
          )
        );
      allow delete: if isSuperAdmin();
    }

    match /roles/{roleId} {
      allow read: if isActiveUser();
      allow write: if isSuperAdmin();
    }

    match /customers/{customerId} {
      allow read: if canReadBusinessResource() && hasSection("sections.clientes");
      allow create: if (isAdmin() || isOperativo()) && canCreateBusinessResource();
      allow update: if (isAdmin() || isOperativo()) && canUpdateBusinessResource();
      allow delete: if isSuperAdmin() && canReadBusinessResource();
    }

    match /routes/{routeId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /localities/{localityId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    match /route_runs/{runId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (hasCapability("cap.returns.create") && onlyChanges(["counts", "updatedAt"]))
        || hasCapability("cap.runs.complete");
      allow delete: if isSuperAdmin();

      match /stops/{orderId} {
        allow read: if isActiveUser();
        allow write: if isAdmin()
          || hasCapability("cap.returns.create")
          || hasCapability("cap.delivery.mark_delivered")
          || hasCapability("cap.delivery.mark_partial");
      }
    }

    match /shipments/{shipmentId} {
      allow read: if isActiveUser()
        && (
          hasSection("sections.embarques")
          || hasSection("sections.durango")
          || hasCapability("cap.shipments.view")
        );
      allow create: if isActiveUser()
        && (
          hasCapability("cap.shipments.create")
          || hasSection("sections.embarques")
        );
      allow update: if isActiveUser()
        && (
          hasCapability("cap.shipments.edit")
          || hasCapability("cap.shipments.send")
          || hasCapability("cap.shipments.receive")
          || hasCapability("cap.shipments.close")
          || hasSection("sections.embarques")
          || hasSection("sections.durango")
        );
      allow delete: if isSuperAdmin();
    }

    match /orders/{orderId} {
      allow read: if canReadBusinessResource();
      allow create: if (isAdmin() || isOperativo()) && canCreateBusinessResource();

      // Operativo can request dispatch and mark packing done.
      // Admin/Super admin can also accept/reject request and assign to route_run.
      allow update: if (
          isAdmin()
          && canUpdateBusinessResource()
          // Los cambios normales a items pasan por el backend autoritativo.
          && !changedKeys().hasAny(["items"])
        )
        // Excepcion temporal y acotada: ReturnsService actualiza items dentro de
        // la misma transaccion que inventario/devolucion. Rules no puede probar
        // diffs arbitrarios dentro de arreglos; por eso se limita por capability
        // y por el conjunto exacto de campos que usa ese flujo.
        || (
          canUpdateBusinessResource()
          && (
            hasCapability("cap.returns.create")
            || hasCapability("cap.returns.approve")
            || hasCapability("cap.returns.restock")
          )
          && changedKeys().hasAny(["items"])
          && onlyChanges(["items", "packages", "totals", "has_returns", "status", "timeline", "updated_at"])
        )
        || (
          canUpdateBusinessResource()
          && hasCapability("cap.payments.register")
          && onlyChanges(["totals", "status", "paid_at", "closed_at", "delivered_at", "timeline", "customer_payment_status", "settlement_status", "collection_status", "collection_reminder_at", "collection_note", "sales_note_last_generated_at", "updated_at"])
        )
        || (
          canUpdateBusinessResource()
          && (hasCapability("cap.delivery.mark_delivered") || hasCapability("cap.delivery.mark_partial"))
          && onlyChanges(["status", "delivery_status", "custody_status", "current_holder_location", "current_holder_user_id", "current_holder_name", "delivered_at", "timeline", "notes", "updated_at"])
        )
        || (
          canUpdateBusinessResource()
          && (
            hasCapability("cap.shipments.create")
            || hasCapability("cap.shipments.edit")
            || hasCapability("cap.shipments.send")
            || hasCapability("cap.shipments.receive")
            || hasCapability("cap.packing.finish")
            || hasCapability("cap.delivery.mark_delivered")
            || hasCapability("cap.delivery.mark_partial")
            || hasCapability("cap.payments.register")
            || hasCapability("cap.settlement.send")
            || hasCapability("cap.settlement.reconcile")
          )
          && onlyChanges(["fulfillment_status", "custody_status", "delivery_status", "customer_payment_status", "settlement_status", "current_holder_location", "current_holder_user_id", "current_holder_name", "shipment_id", "updated_at"])
        )
        || (
          canUpdateBusinessResource()
          && (hasCapability("cap.settlement.send") || hasCapability("cap.settlement.reconcile"))
          && onlyChanges(["settlement_status", "status", "closed_at", "updated_at"])
        )
        || (
          isOperativo()
          && canUpdateBusinessResource()
          && (
            (
              onlyChanges(["dispatch_request", "updated_at"])
              && request.resource.data.dispatch_request.status == "requested"
            )
            || (
              onlyChanges(["status", "packing", "fulfillment_status", "custody_status", "delivery_status", "current_holder_location", "updated_at"])
              && request.resource.data.status == "ready_for_route"
              && request.resource.data.packing.status == "done"
            )
          )
        );

      allow delete: if isSuperAdmin();

      match /events/{eventId} {
        allow read: if canAccessOrder(orderId);
        allow create: if canAccessOrder(orderId)
          && (
            isAdmin()
            || isOperativo()
            || hasCapability("cap.shipments.receive")
            || hasCapability("cap.delivery.mark_delivered")
            || hasCapability("cap.payments.register")
            || hasCapability("cap.settlement.send")
            || hasCapability("cap.settlement.reconcile")
          );
        allow update, delete: if isSuperAdmin();
      }
    }

    match /order_collection_events/{eventId} {
      allow read: if canReadBusinessResource()
        && (
          hasCapability("cap.payments.view")
          || hasCapability("cap.payments.register")
          || hasCapability("cap.settlement.view")
          || hasSection("sections.administracion")
        );
      allow create: if canCreateBusinessResource() && hasCapability("cap.payments.register");
      allow update: if canUpdateBusinessResource()
        && (
          hasCapability("cap.settlement.reconcile")
          || hasSection("sections.administracion")
        );
      allow delete: if false;
    }

    match /operational_expense_reports/{reportId} {
      allow read: if canReadBusinessResource()
        && (
          hasSection("sections.durango")
          || hasSection("sections.administracion")
          || hasCapability("cap.finance.movements.view")
        );
      allow create: if canCreateBusinessResource()
        && (
          hasSection("sections.durango")
          || hasSection("sections.administracion")
        );
      allow update: if canUpdateBusinessResource()
        && (
          hasSection("sections.administracion")
          || hasCapability("cap.finance.movements.create")
          || hasCapability("cap.finance.movements.edit")
        );
      allow delete: if isSuperAdmin();
    }

    match /order_settlement_events/{eventId} {
      allow read: if canReadBusinessResource()
        && (
          hasCapability("cap.settlement.view")
          || hasSection("sections.administracion")
        );
      allow create: if canCreateBusinessResource()
        && (hasCapability("cap.settlement.send") || hasCapability("cap.settlement.reconcile"));
      allow update, delete: if false;
    }

    match /finance_accounts/{accountId} {
      allow read: if canReadBusinessResource()
        && (
          hasSection("sections.administracion")
          || hasCapability("cap.finance.accounts.view")
          || hasCapability("cap.payments.refund")
        );
      allow create: if canCreateBusinessResource() && hasCapability("cap.finance.accounts.create");
      allow update: if canUpdateBusinessResource()
        && (
          hasCapability("cap.finance.accounts.edit")
          || (
            hasCapability("cap.payments.refund")
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["balance", "updated_at"])
            && request.resource.data.balance is number
            && resource.data.balance is number
            && request.resource.data.balance <= resource.data.balance
          )
        );
      allow delete: if canReadBusinessResource() && hasCapability("cap.finance.accounts.delete");
    }

    match /finance_expenses/{expenseId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.administracion") || hasCapability("cap.finance.movements.view"));
      allow create: if canCreateBusinessResource() && hasCapability("cap.finance.movements.create");
      allow update: if canUpdateBusinessResource() && hasCapability("cap.finance.movements.edit");
      allow delete: if canReadBusinessResource() && hasCapability("cap.finance.movements.delete");
    }

    match /finance_withdrawals/{withdrawalId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.administracion") || hasCapability("cap.finance.movements.view"));
      allow create: if canCreateBusinessResource() && hasCapability("cap.finance.movements.create");
      allow update: if canUpdateBusinessResource() && hasCapability("cap.finance.movements.edit");
      allow delete: if canReadBusinessResource() && hasCapability("cap.finance.movements.delete");
    }

    match /finance_cuts/{cutId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.administracion") || hasCapability("cap.finance.reports.view"));
      allow create: if canCreateBusinessResource() && hasCapability("cap.finance.reports.view");
      allow update, delete: if isSuperAdmin();
    }

    match /inventory_items/{itemId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.inventario") || hasCapability("cap.inventory.view"));
      allow create: if canCreateBusinessResource() && (hasCapability("cap.inventory.adjust") || hasCapability("cap.inventory.receive"));
      allow update: if canUpdateBusinessResource() && (hasCapability("cap.inventory.adjust") || hasCapability("cap.inventory.receive") || hasCapability("cap.inventory.reserve") || hasCapability("cap.inventory.release") || hasCapability("cap.delivery.mark_delivered"));
      allow delete: if canReadBusinessResource() && (isSuperAdmin() || hasCapability("cap.inventory.override"));
    }

    match /inventory_movements/{movementId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.inventario") || hasCapability("cap.inventory.view"));
      allow create: if canCreateBusinessResource()
        && (hasCapability("cap.inventory.adjust") || hasCapability("cap.inventory.receive") || hasCapability("cap.inventory.reserve") || hasCapability("cap.inventory.release") || hasCapability("cap.delivery.mark_delivered") || hasCapability("cap.returns.create") || hasCapability("cap.returns.approve"))
        && getAfter(/databases/$(database)/documents/inventory_items/$(request.resource.data.inventory_id)).data.business_id == incomingBusinessId();
      allow update, delete: if false;
    }

    match /suppliers/{supplierId} {
      allow read: if canReadBusinessResource() && hasSection("sections.proveedores");
      allow create: if canCreateBusinessResource() && isAdmin();
      allow update: if canUpdateBusinessResource() && isAdmin();
      allow delete: if canReadBusinessResource() && isSuperAdmin();
    }

    match /supplier_operations/{operationId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.proveedores") || hasCapability("cap.suppliers.ops.view"));
      allow create: if canCreateBusinessResource() && (isAdmin() || isOperativo());
      allow update: if canUpdateBusinessResource() && (hasCapability("cap.suppliers.ops.advance_state") || hasCapability("cap.suppliers.ops.partial_process"));
      allow delete: if canReadBusinessResource() && (isSuperAdmin() || hasCapability("cap.suppliers.ops.override"));
    }

    match /normalized_listings/{listingId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.catalogo") || hasSection("sections.validacion"));
      allow create: if canCreateBusinessResource() && (isAdmin() || isOperativo());
      allow update: if canUpdateBusinessResource() && (hasCapability("cap.validation.confirm_stock") || hasCapability("cap.validation.override_stock") || hasSection("sections.catalogo"));
      allow delete: if canReadBusinessResource() && isSuperAdmin();
    }

    match /catalog_products/{productId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      // El catálogo v2 se escribe exclusivamente desde el backend con Admin SDK.
      // Esto evita que una importación parcial desde el navegador rompa identidades,
      // revisiones o índices de identificadores.
      allow create, update, delete: if false;
    }

    match /catalog_product_groups/{groupId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_product_identifiers/{identifierId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_product_listings/{listingId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_import_profiles/{profileId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_bundle_components/{componentId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_product_bundles/{bundleId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_generations/{generationId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_import_generation_changes/{changeId} {
      allow read, create, update, delete: if false;
    }

    match /catalog_barcode_aliases/{aliasId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      // Compatibilidad de lectura hasta completar el backfill a ocr_alias.
      allow create, update, delete: if false;
    }

    match /manual_product_suggestions/{entryId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create: if canCreateBusinessResource() && (isAdmin() || isOperativo());
      allow update: if canUpdateBusinessResource() && (isAdmin() || isOperativo());
      allow delete: if canReadBusinessResource() && isAdmin();
    }

    match /returns/{returnId} {
      allow read: if canReadBusinessResource() && (hasCapability("cap.returns.view") || hasSection("sections.inventario"));
      allow create: if canCreateBusinessResource()
        && hasCapability("cap.returns.create")
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.has_returns == true
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.order_id)).data.business_id == incomingBusinessId();
      allow update: if canUpdateBusinessResource() && (hasCapability("cap.returns.restock") || hasCapability("cap.returns.approve"));
      allow delete: if canReadBusinessResource() && isSuperAdmin();
    }

    match /customer_credit_movements/{movementId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.clientes") || hasSection("sections.administracion"));
      allow create: if canCreateBusinessResource()
        && (hasCapability("cap.returns.create") || hasCapability("cap.payments.register") || hasCapability("cap.payments.refund"))
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customer_id)).data.business_id == incomingBusinessId();
      allow update, delete: if false;
    }

    match /customer_followups/{followupId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.clientes") || hasSection("sections.administracion") || hasCapability("cap.payments.view"));
      allow create: if (isAdmin() || isOperativo())
        && canCreateBusinessResource()
        && (hasSection("sections.clientes") || hasSection("sections.administracion") || hasCapability("cap.payments.register"))
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customer_id)).data.business_id == incomingBusinessId();
      allow update: if (isAdmin() || isOperativo())
        && canUpdateBusinessResource()
        && (hasSection("sections.clientes") || hasSection("sections.administracion") || hasCapability("cap.payments.register"))
        && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.customer_id)).data.business_id == incomingBusinessId();
      allow delete: if isSuperAdmin() && canReadBusinessResource();
    }

    match /finance_refunds/{refundId} {
      allow read: if canReadBusinessResource() && (hasSection("sections.administracion") || hasCapability("cap.finance.movements.view"));
      allow create: if canCreateBusinessResource()
        && hasCapability("cap.payments.refund")
        && getAfter(/databases/$(database)/documents/finance_accounts/$(request.resource.data.account_id)).data.business_id == incomingBusinessId();
      allow update, delete: if isSuperAdmin();
    }

    match /catalog_import_jobs/{jobId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    match /catalog_import_rows/{rowId} {
      allow read: if canReadBusinessResource() && hasSection("sections.catalogo");
      allow create, update, delete: if false;
    }

    // TODO: migrate these checks to full capabilities-based rules using custom claims
    // or a dedicated authorization projection document.
  }
}
